# ========================================================
# SEO PILOT AI - Environment Configuration Template
# Copy this file to .env and fill in your authorized credentials
# ========================================================

# Application Settings
APP_ENV=development
APP_SECRET_KEY=change-this-in-production-to-a-secure-random-32-char-string
PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=sqlite+aiosqlite:///./data/seopilot.db

# Google OAuth2 Credentials (Search Console & Analytics API)
# Setup in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/oauth2callback

# AI Provider API Keys
# Gemini API Key (From Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Anthropic Claude API Key (From Anthropic Console: https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenAI API Key (From OpenAI Platform: https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Meta / Local Model Configuration (Ollama, vLLM, or Open-Source LLM Endpoint)
META_AI_BASE_URL=http://localhost:11434/v1
META_AI_MODEL=llama3.2
META_AI_API_KEY=

# GitHub Version Control
# GitHub Personal Access Token (PAT) with repo permissions: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_DEFAULT_BRANCH=main

# Operational & Safety Controls
MAX_CRAWL_PAGES=50
CRAWL_TIMEOUT_SECONDS=15
AUTO_ROLLBACK_ON_TEST_FAILURE=true
REQUIRE_CONSOLIDATED_APPROVAL=true
